[Unit]
Description=Retenção de 30 dias para os feeds-arquivo do MISP (score.cecyber.com)
Documentation=https://github.com/almirmeira/panorama-risco-cyber-financeiro-energia
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
# Precisa de root: fala com o socket do Docker.
User=root
Environment=MISP_RETENCAO_DIAS=30
Environment=MISP_RETENCAO_ORGS=abuse.ch
ExecStart=/usr/local/sbin/misp-retencao.sh
